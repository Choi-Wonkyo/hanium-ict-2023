<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/mainhigh"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintBottom_toTopOf="@+id/viewPager"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_margin="20dp">

    <Button
            android:id="@+id/buttonAnnouncement"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="공지사항"
            android:background="@drawable/btn_rounded"
            android:textColor="@color/colorWhite"
            android:layout_weight="1"
            android:layout_marginEnd="15dp"/>

        <TextView
            android:id="@+id/hightext"
            android:layout_width="148dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_weight="1"
            android:background="@color/colorPurple"
            android:gravity="center"
            android:text="@string/app_name"
            android:textColor="@color/colorWhite"
            android:textSize="20sp" />

        <Button
            android:id="@+id/buttonContact"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="문의하기"
            android:background="@drawable/btn_rounded"
            android:textColor="@color/colorWhite"
            android:layout_weight="1"
            android:layout_marginStart="15dp"/>

    </LinearLayout>


    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/viewPager"
        android:layout_width="match_parent"
        android:layout_height="450dp"
        android:layout_marginTop="40dp"
        android:layout_marginBottom="0sp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/buttonLayout" />

    <LinearLayout
        android:id="@+id/buttonLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintTop_toBottomOf="@id/viewPager"
        android:layout_marginTop="0dp"
        android:layout_margin="20dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:padding="5dp"
        android:layout_marginBottom="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="0dp">

            <Button
                android:id="@+id/buttonAR"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="AR 가구 배치"
                android:textSize="20dp"
                android:background="@drawable/btn_border1"
                android:textColor="@color/colorARButton"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"/>

            <View
                android:layout_width="5dp"
                android:layout_height="1dp" />

            <Button
                android:id="@+id/buttonAnalysis"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="성향분석"
                android:textSize="20dp"
                android:background="@drawable/btn_border2"
                android:textColor="@color/colorAnalyzeButton"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"/>

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="10dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/buttonList"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="가구리스트"
                android:textSize="20dp"
                android:background="@drawable/btn_border3"
                android:textColor="@color/colorBurgundy"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"/>

            <View
                android:layout_width="5dp"
                android:layout_height="1dp" />

            <Button
                android:id="@+id/buttonCommunity"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="커뮤니티"
                android:textSize="20dp"
                android:background="@drawable/btn_border1"
                android:textColor="@color/colorCommunityButton"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"/>

        </LinearLayout>

    </LinearLayout>

    <Button
        android:id="@+id/buttonRecommendation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="AI 추천 받기"
        android:textSize="20dp"
        app:layout_constraintTop_toBottomOf="@id/buttonLayout"
        android:layout_marginTop="5dp"
        android:background="@drawable/btn_email_login"
        android:layout_marginStart="24dp"
        android:layout_weight="1"
        android:layout_marginEnd="25dp"/>


</androidx.constraintlayout.widget.ConstraintLayout>

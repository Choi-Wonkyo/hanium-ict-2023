<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="8dp">

    <!-- 가구 이미지 -->
    <ImageView
        android:id="@+id/furnitureImage"
        android:layout_width="150dp"
        android:layout_height="150dp"
        android:scaleType="fitXY"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginEnd="8dp"
        android:src="@drawable/ic_furniture_placeholder" />

    <!-- 가구 이름 -->
    <TextView
        android:id="@+id/furnitureName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="가구 이름"
        android:textColor="@color/colorBlack"
        android:textSize="25sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="@id/furnitureImage"
        app:layout_constraintStart_toEndOf="@id/furnitureImage" />

    <!-- 가구 가격 -->
    <TextView
        android:id="@+id/furniturePrice"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="가구 가격"
        android:textColor="@color/colorBlack"
        android:textSize="23sp"
        app:layout_constraintTop_toBottomOf="@id/furnitureManufacture"
        app:layout_constraintStart_toStartOf="@id/furnitureManufacture" />

    <!-- 가구 제조사 -->
    <TextView
        android:id="@+id/furnitureManufacture"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="가구 제조사"
        android:textSize="20sp"
        android:textColor="@color/colorBlack"
        android:layout_gravity="center"
        app:layout_constraintTop_toBottomOf="@id/furnitureName"
        app:layout_constraintStart_toStartOf="@id/furnitureName" />

    <!-- 가구 설명 -->
    <TextView
        android:id="@+id/furnitureDescription"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="가구 설명"
        android:textColor="@color/colorBlack"
        android:textSize="14sp"
        android:layout_gravity="center"
        app:layout_constraintTop_toBottomOf="@id/furniturePrice"
        app:layout_constraintStart_toStartOf="@id/furniturePrice" />

    <!-- "See details" 버튼 -->
    <Button
        android:id="@+id/detailsButton"
        android:layout_width="120dp"
        android:layout_height="wrap_content"
        android:text="See details"
        android:layout_gravity="center"
        app:layout_constraintTop_toBottomOf="@id/furnitureDescription"
        app:layout_constraintStart_toStartOf="@id/furnitureDescription" />

    <!-- "Try AR" 버튼 -->
    <Button
        android:id="@+id/tryARButton"
        android:layout_width="100dp"
        android:layout_height="wrap_content"
        android:text="Try AR"
        android:layout_gravity="center"
        app:layout_constraintTop_toBottomOf="@id/furnitureDescription"
        app:layout_constraintStart_toEndOf="@id/detailsButton"
        android:layout_marginStart="8dp" />
</androidx.constraintlayout.widget.ConstraintLayout>

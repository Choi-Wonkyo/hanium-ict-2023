<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F2E6D6">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/analysisButtonLeft10"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginStart="-100dp"
            android:layout_marginTop="-200dp"
            android:layout_marginBottom="-40dp"
            android:background="@null"
            android:onClick="onLeftImageClick"
            android:scaleType="fitXY"
            android:src="@drawable/analysis10_5"
            android:layout_marginEnd="60dp" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/analysisButtonRight10"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginStart="150dp"
            android:layout_marginTop="0dp"
            android:layout_marginBottom="-300dp"
            android:background="@null"
            android:onClick="onLeftImageClick"
            android:rotation="29"
            android:scaleType="fitXY"
            android:src="@drawable/analysis10_1"
            android:layout_marginEnd="-120dp" />
    </LinearLayout>

    <TextView
        android:id="@+id/analysis"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:textColor="#FFFFFF"
        android:textSize="55sp"
        android:textStyle="bold"
        android:gravity="center"
        android:fontFamily="@font/hakgyoansimbunpilr"
        android:text="성향분석"
        android:layout_centerInParent="true" />

</FrameLayout>